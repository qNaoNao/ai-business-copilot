OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5-mini

# UI defaults to free demo regardless of whether a key is present.
# Hybrid uses the local index; missing/stale index visibly falls back to BM25.
COPILOT_RETRIEVAL=hybrid
# Optional: use synthetic data instead of your private database.
# BUSINESS_DB_PATH=.demo/business.db

# Optional estimate only: fill all THREE current rates for the chosen model.
# Empty rates show null/unknown cost; do not guess. Billing is authoritative.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_CACHED_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=

# Optional: lock the web UI to free mode (recommended for demonstrations).
COPILOT_DEMO_ONLY=false
# Optional saved analyses path; default is runs/analyses.sqlite3.
# COPILOT_ANALYSIS_STORE=runs/analyses.sqlite3

# Optional separate read-only metrics API. Generate locally; never commit tokens.
# API does not auto-load this .env. Export API tokens in its own terminal.
# COPILOT_API_TOKEN=<random-32-or-more-ASCII-characters>
# COPILOT_VIEWER_TOKEN=<a-different-random-32-or-more-ASCII-token>
