    "id": "monthly_kpis_jan_feb_2018",
    "question": "2018年1月和2月的核心经营指标是否准确？",
    "tool": "get_monthly_kpis",
    "arguments": {
      "start_month": "2018-01",
      "end_month": "2018-02"
    },
    "checks": [
      {
        "type": "row_count",
        "expected": 2
      },
      {
        "type": "row",
        "where": {"month": "2018-01"},
        "expected": {
          "gmv": {"approx": 924645.0, "abs_tol": 0.01},
          "orders": 7069,
          "customers": 6974,
          "aov": {"approx": 130.8028009619, "abs_tol": 0.000001},
          "days_in_month": 31
        }
      },
      {
        "type": "row",
        "where": {"month": "2018-02"},
        "expected": {
          "gmv": {"approx": 826437.13, "abs_tol": 0.01},
          "orders": 6555,
          "customers": 6400,
          "aov": {"approx": 126.0773653699, "abs_tol": 0.000001},
          "days_in_month": 28
        }
      }
    ]
  },
